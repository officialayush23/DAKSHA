# Copy to BACKEND/.env and fill in. Optional lines can be left empty.

# ── Database (Supabase Postgres + pgvector + PostGIS) ─────────────────────────
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
LANGGRAPH_DB_URL=postgresql://postgres.<project>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ── Model gateway ─────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                     # primary: gemini | bedrock
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-2.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_VERTEX_API_KEY=                  # AI Studio / Vertex express key (AQ. prefix)
GEMINI_API_KEY=                         # optional second key
GOOGLE_CLOUD_PROJECT=                   # optional: Vertex with a service account (needs billing)
GOOGLE_APPLICATION_CREDENTIALS_JSON=
AWS_API_KEY_BEDROCK_FOR_XAI=            # optional fallback: Bedrock API key (ABSK...)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.xai.grok-4.7

# ── Orchestration ─────────────────────────────────────────────────────────────
DAKSHA_DOMAIN=commerce
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_MIN=60
KIOSK_OTP_REQUIRED=true
KIOSK_TOKEN_TTL_MIN=30
KIOSK_TOKEN_SECRET=                     # defaults to a value derived from SUPABASE_JWT_SECRET

# ── Embeddings (Nomic) ────────────────────────────────────────────────────────
NOMIC_API_KEY=
NOMIC_TEXT_MODEL=nomic-embed-text-v1.5
NOMIC_VISION_MODEL=nomic-embed-vision-v1.5
NOMIC_MATRYOSHKA_DIM=768

# ── Maps (Mapbox) ─────────────────────────────────────────────────────────────
MAPBOX_TOKEN=pk.                        # public token
MAP_BOX_API_KEY=sk.                     # secret token for server-side geocoding

# ── Optional infrastructure ───────────────────────────────────────────────────
REDIS_URL=                              # empty = in-process cache/OTP store (single instance)
CELERY_ENABLED=false
WEBHOOK_SECRET=                         # courier + Telegram webhook shared secret

# ── Notifications ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
RESEND_API_KEY=
TELEGRAM_TOKEN=

FRONTEND_URLS=https://<your-vercel-app>.vercel.app
